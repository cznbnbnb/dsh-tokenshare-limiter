{
  "name": "dsh-tokenshare-limiter",
  "version": "1.2.1",
  "description": "TokenShare 请求节流、异常重放与单提示词图片上限恢复；保留原始附件并复用 DSH 图片转存。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tokenshare",
    "rate-limit",
    "throttle",
    "retry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cznbnbnb/dsh-tokenshare-limiter.git"
  },
  "homepage": "https://github.com/cznbnbnb/dsh-tokenshare-limiter#readme",
  "bugs": {
    "url": "https://github.com/cznbnbnb/dsh-tokenshare-limiter/issues"
  },
  "exports": {
    ".": "./index.js",
    "./image-limit": "./image-limit.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "image-limit.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
